import os, numpy as np, segyio, gradio as gr
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

INV = "/data/epic20/APGCE/input_data/challenge1_challenge2/inversion"
VOLUMES = {
    "Total Sand Probability": "Challenge1_Challenge2_Inversion_TotalSandProbability_cropped.sgy",
    "Vp/Vs":                  "Challenge1_Challenge2_Inversion_VpVs_cropped.sgy",
    "P-Impedance":            "Challenge1_Challenge2_Inversion_P_Impedance_cropped.sgy",
}
CMAPS = {"Total Sand Probability": "hot_r", "Vp/Vs": "viridis", "P-Impedance": "seismic"}

def n_samples(nama):
    with segyio.open(f"{INV}/{VOLUMES[nama]}") as f:
        return len(f.samples)

def papar_slice(nama, peratus):
    with segyio.open(f"{INV}/{VOLUMES[nama]}") as f:
        idx = int((len(f.samples) - 1) * peratus / 100)
        s = f.depth_slice[idx]
    fig, ax = plt.subplots(figsize=(6.5, 6))
    im = ax.imshow(s.T, cmap=CMAPS[nama], aspect="auto")
    ax.set_title(f"{nama} | sampel {idx}")
    ax.set_xlabel("Inline"); ax.set_ylabel("Crossline")
    fig.colorbar(im, ax=ax, shrink=0.8)
    fig.tight_layout()
    plt.close(fig)
    return fig

